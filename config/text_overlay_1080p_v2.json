{
  "version": "text_overlay_1080p_v2",
  "canvas": {
    "width": 1920,
    "height": 1080
  },
  "raster_scale": 2,
  "font": {
    "source": "local_only",
    "default_path": "fonts/BpmfHuninn-Regular.ttf",
    "path_env": "BPMF_FONT_PATH",
    "git_policy": "fonts/ and font binaries must stay untracked",
    "ivs_spec": "ButTaiwan/bpmfvs",
    "bopomofo_fields": [
      "title",
      "content"
    ],
    "plain_fields": [
      "author",
      "poem_type",
      "child_explanation_6_8"
    ]
  },
  "zones": {
    "title": {
      "x": 120,
      "y": 44,
      "width": 1680,
      "height": 118,
      "align": "center",
      "persistence": "whole_video"
    },
    "author": {
      "x": 120,
      "y": 164,
      "width": 1680,
      "height": 58,
      "align": "center",
      "persistence": "whole_video"
    },
    "poem_type": {
      "x": 120,
      "y": 218,
      "width": 1680,
      "height": 42,
      "align": "center",
      "persistence": "intro_end_only"
    },
    "content": {
      "x": 160,
      "y": 286,
      "width": 1600,
      "height": 500,
      "align": "center",
      "page_capacity": 4,
      "page_policy": "fixed_slots_then_region_page_turn",
      "reveal_policy": "progressive_accumulate_within_page",
      "reset_policy": "clear_content_zone_on_page_turn",
      "slots": [
        {
          "slot": 1,
          "center_y": 340
        },
        {
          "slot": 2,
          "center_y": 462
        },
        {
          "slot": 3,
          "center_y": 584
        },
        {
          "slot": 4,
          "center_y": 706
        }
      ]
    },
    "explanation": {
      "x": 180,
      "y": 844,
      "width": 1560,
      "height": 128,
      "align": "center",
      "persistence": "active_scene_only"
    }
  },
  "typography": {
    "title": {
      "candidate_font_px": [
        108,
        96,
        84,
        72,
        60,
        48,
        36
      ],
      "single_line": true,
      "fit": "largest_discrete_size_that_fits_width"
    },
    "author": {
      "candidate_font_px": [
        48,
        44,
        40,
        36,
        32
      ],
      "single_line": true,
      "fit": "largest_discrete_size_that_fits_width"
    },
    "poem_type": {
      "candidate_font_px": [
        34,
        30,
        28,
        26
      ],
      "single_line": true,
      "fit": "largest_discrete_size_that_fits_width"
    },
    "content": {
      "candidate_font_px": [
        96,
        92,
        88,
        84,
        80,
        76,
        72,
        68,
        64,
        60,
        56
      ],
      "single_line_per_asset": true,
      "size_scope": "one_content_page",
      "size_rule": "choose_one_size_for_all_nonblank_lines_on_page_using_longest_measured_glyph_bbox",
      "fit": "largest_discrete_size_that_fits_width",
      "overflow_policy": "qa_fail_if_page_lines_cannot_fit_at_56px",
      "total_poem_line_count_must_not_reduce_font_size": true
    },
    "explanation": {
      "candidate_font_px": [
        42,
        38,
        34,
        30,
        28,
        26,
        24
      ],
      "single_line": true,
      "fit": "largest_discrete_size_that_fits_width",
      "mode": "active_scene_only"
    }
  },
  "page_logic": {
    "content_page_capacity": 4,
    "blank_scene_policy": "separator_and_force_page_turn_if_current_page_has_content",
    "line_assignment": "sequential_nonblank_scene_order_with_blank_scene_preserved_in_manifest",
    "progressive_behavior": [
      "scene enters its fixed slot",
      "previous lines on same page remain visible",
      "no existing line changes position after reveal",
      "next page clears content zone before first line appears"
    ]
  },
  "appearance": {
    "title_content": {
      "fill": "#FFF8E8",
      "stroke": "#1A1A1A",
      "stroke_px": 3,
      "shadow": {
        "dx": 2,
        "dy": 3,
        "blur_px": 4,
        "alpha": 0.45
      }
    },
    "meta_explanation": {
      "fill": "#F7F2E8",
      "stroke": "#1A1A1A",
      "stroke_px": 2,
      "shadow": {
        "dx": 2,
        "dy": 2,
        "blur_px": 3,
        "alpha": 0.4
      }
    }
  },
  "output": {
    "image_format": "PNG",
    "background": "transparent",
    "crop": "tight_bbox_with_padding",
    "padding_px": 12,
    "manifest_coordinates": "display_space_1920x1080"
  },
  "pronunciation_override": {
    "storage": "data/bopomofo_overrides.json",
    "applies_to": [
      "title",
      "content"
    ],
    "method": "insert_explicit_IVS_selector_after_target_character",
    "qa": "source_text_must_match_before_override"
  }
}
